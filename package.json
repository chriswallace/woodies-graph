{
  "name": "woodies-graph",
  "version": "1.0.0",
  "private": true,
  "description": "GraphQL endpoint for verifying Woodies NFT holders (Decentraland-compatible), served from a Cloudflare Worker with no database.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
